    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.24.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
